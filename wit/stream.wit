package kairo:example@0.1.0;

world transform {
    export transform: async func(input: stream<u8>) -> stream<u8>;
}

world consume {
    export consume: async func(input: stream<u8>) -> u64;
}

interface stream-metrics {
    record metric {
        name: string,
        value: u64,
    }
}

world consume-metrics {
    use stream-metrics.{metric};
    export consume: async func(input: stream<u8>) -> result<list<metric>, string>;
}

world output {
    export output: async func(input: stream<u8>) -> result<list<u8>, string>;
}
